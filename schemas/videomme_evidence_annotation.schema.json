{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/videomme_evidence_annotation.schema.json",
  "title": "VideoMME-Evidence30 annotation record",
  "description": "One question-level evidence annotation record. Draft records may be incomplete; locked records are constrained by allOf rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "record_status",
    "split",
    "source",
    "question",
    "validity",
    "evidence_contract",
    "hard_negatives",
    "annotation_notes",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "videomme-evidence30/0.2.0"
    },
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": ["draft", "in_review", "locked", "excluded"]
    },
    "split": {
      "enum": ["candidate", "dev", "locked", "excluded"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "evidence_contract": {
      "$ref": "#/$defs/evidenceContract"
    },
    "hard_negatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hardNegative"
      }
    },
    "annotation_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "locked"
          }
        },
        "required": ["record_status"]
      },
      "then": {
        "properties": {
          "split": {
            "enum": ["dev", "locked"]
          },
          "validity": {
            "properties": {
              "status": {
                "const": "valid"
              }
            },
            "required": ["status"]
          },
          "evidence_contract": {
            "properties": {
              "primary_topology": {
                "enum": ["local", "sequence", "multi_set", "global", "exclusion"]
              },
              "required_modalities": {
                "minItems": 1
              },
              "evidence_slots": {
                "minItems": 1
              },
              "sufficient_evidence_sets": {
                "minItems": 1
              }
            }
          },
          "review": {
            "properties": {
              "mode": {
                "const": "single_annotator"
              },
              "status": {
                "const": "locked"
              },
              "annotator_a": {
                "$ref": "#/$defs/reviewer"
              },
              "annotator_b": {
                "type": "null"
              },
              "adjudicator": {
                "type": "null"
              },
              "locked_at": {
                "type": "string",
                "format": "date-time"
              },
              "content_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "excluded"
          }
        },
        "required": ["record_status"]
      },
      "then": {
        "properties": {
          "split": {
            "const": "excluded"
          },
          "validity": {
            "properties": {
              "status": {
                "enum": [
                  "ambiguous",
                  "incorrect_official_answer",
                  "insufficient_observable_evidence",
                  "unsupported_modality",
                  "broken_media"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sec", "end_sec"],
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "end_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "optionId": {
      "type": "string",
      "pattern": "^O[1-4]$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "video_id",
        "question_id",
        "duration_bucket",
        "domain",
        "sub_category",
        "task_type",
        "video_sha256",
        "subtitle_sha256"
      ],
      "properties": {
        "dataset": {
          "const": "Video-MME"
        },
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_bucket": {
          "enum": ["short", "medium", "long", "unknown"]
        },
        "domain": {
          "type": "string"
        },
        "sub_category": {
          "type": "string"
        },
        "task_type": {
          "type": "string"
        },
        "video_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "subtitle_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "benchmark_label", "text"],
      "properties": {
        "option_id": {
          "$ref": "#/$defs/optionId"
        },
        "benchmark_label": {
          "type": "string",
          "pattern": "^[A-D]$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answerReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "benchmark_label"],
      "properties": {
        "option_id": {
          "$ref": "#/$defs/optionId"
        },
        "benchmark_label": {
          "type": "string",
          "pattern": "^[A-D]$"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "options", "official_answer"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "official_answer": {
          "$ref": "#/$defs/answerReference"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "valid",
            "ambiguous",
            "incorrect_official_answer",
            "insufficient_observable_evidence",
            "unsupported_modality",
            "broken_media"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "evidenceSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "description", "required"],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "constraint": {
          "type": ["string", "null"]
        }
      }
    },
    "sourceReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_timestamps_sec", "subtitle_cue_ids", "ocr_text"],
      "properties": {
        "frame_timestamps_sec": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "subtitle_cue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ocr_text": {
          "type": ["string", "null"]
        }
      }
    },
    "minimumObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min_frames", "min_temporal_span_sec"],
      "properties": {
        "mode": {
          "enum": ["overview", "inspect", "motion", "detail_ocr", "subtitle", "coverage"]
        },
        "min_frames": {
          "type": "integer",
          "minimum": 0
        },
        "min_temporal_span_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "slot_id",
        "required",
        "core_interval",
        "context_interval",
        "modality",
        "observation_requirement",
        "minimum_observation",
        "atomic_fact",
        "roles",
        "supports_option_ids",
        "refutes_option_ids",
        "source_references"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^E[1-9][0-9]*$"
        },
        "slot_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "required": {
          "type": "boolean"
        },
        "core_interval": {
          "$ref": "#/$defs/interval"
        },
        "context_interval": {
          "$ref": "#/$defs/interval"
        },
        "modality": {
          "enum": ["visual", "subtitle", "ocr"]
        },
        "observation_requirement": {
          "enum": [
            "point_frame",
            "ordered_frames",
            "short_clip",
            "subtitle_cues",
            "readable_ocr",
            "representative_coverage",
            "exhaustive_coverage"
          ]
        },
        "minimum_observation": {
          "$ref": "#/$defs/minimumObservation"
        },
        "atomic_fact": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "support",
              "refute",
              "context",
              "order_anchor",
              "counterexample",
              "coverage"
            ]
          }
        },
        "supports_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optionId"
          }
        },
        "refutes_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optionId"
          }
        },
        "source_references": {
          "$ref": "#/$defs/sourceReferences"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "source_evidence_ids", "description"],
      "properties": {
        "relation": {
          "enum": [
            "before",
            "after",
            "overlaps",
            "causes",
            "changes_to",
            "same_event",
            "different_occurrence"
          ]
        },
        "source_evidence_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[1-9][0-9]*$"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_id", "description", "logic", "items", "relations"],
      "properties": {
        "set_id": {
          "type": "string",
          "pattern": "^ES[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "logic": {
          "const": "all_required"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "coverageSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "interval", "reason"],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "globalCoverageContract": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage_type",
            "scope_description",
            "required_segments",
            "max_unobserved_gap_sec",
            "absence_claim"
          ],
          "properties": {
            "coverage_type": {
              "enum": ["representative", "exhaustive"]
            },
            "scope_description": {
              "type": "string",
              "minLength": 1
            },
            "required_segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/coverageSegment"
              }
            },
            "max_unobserved_gap_sec": {
              "type": "number",
              "minimum": 0
            },
            "absence_claim": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_topology",
        "secondary_topologies",
        "required_modalities",
        "answer_criterion",
        "evidence_slots",
        "sufficient_evidence_sets",
        "global_coverage_contract"
      ],
      "properties": {
        "primary_topology": {
          "enum": ["pending", "local", "sequence", "multi_set", "global", "exclusion"]
        },
        "secondary_topologies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["local", "sequence", "multi_set", "global", "exclusion"]
          }
        },
        "required_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["visual", "subtitle", "ocr"]
          }
        },
        "answer_criterion": {
          "enum": ["pending", "direct_support", "elimination", "mixed", "coverage"]
        },
        "evidence_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceSlot"
          }
        },
        "sufficient_evidence_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceSet"
          }
        },
        "global_coverage_contract": {
          "$ref": "#/$defs/globalCoverageContract"
        }
      }
    },
    "hardNegative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negative_id",
        "interval",
        "modalities",
        "plausibility",
        "insufficiency_reason",
        "tempts_option_ids"
      ],
      "properties": {
        "negative_id": {
          "type": "string",
          "pattern": "^HN[1-9][0-9]*$"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["visual", "subtitle", "ocr"]
          }
        },
        "plausibility": {
          "type": "string",
          "minLength": 1
        },
        "insufficiency_reason": {
          "type": "string",
          "minLength": 1
        },
        "tempts_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optionId"
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "completed_at"],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "nullableReviewer": {
      "oneOf": [
        {
          "$ref": "#/$defs/reviewer"
        },
        {
          "type": "null"
        }
      ]
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validity", "topology", "modalities", "sufficient_set", "notes"],
      "properties": {
        "validity": {
          "type": ["boolean", "null"]
        },
        "topology": {
          "type": ["boolean", "null"]
        },
        "modalities": {
          "type": ["boolean", "null"]
        },
        "sufficient_set": {
          "type": ["boolean", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "annotator_a",
        "annotator_b",
        "adjudicator",
        "agreement",
        "locked_at",
        "content_sha256",
        "notes"
      ],
      "properties": {
        "mode": {
          "enum": ["single_annotator", "dual_annotator"]
        },
        "status": {
          "enum": ["draft", "in_review", "adjudicated", "locked"]
        },
        "annotator_a": {
          "$ref": "#/$defs/nullableReviewer"
        },
        "annotator_b": {
          "$ref": "#/$defs/nullableReviewer"
        },
        "adjudicator": {
          "$ref": "#/$defs/nullableReviewer"
        },
        "agreement": {
          "$ref": "#/$defs/agreement"
        },
        "locked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "content_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
